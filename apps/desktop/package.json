{
  "name": "dira",
  "version": "1.2.24",
  "private": true,
  "description": "티켓 큐를 보는 화면",
  "author": "dira",
  "type": "module",
  "main": "main.ts",
  "scripts": {
    "build": "cd ../teams && pnpm build && rm -rf .next/standalone/.next/static .next/standalone/public && cp -R .next/static .next/standalone/.next/static && { [ -d public ] && cp -R public .next/standalone/public || true; } && find .next/standalone -type l ! -exec test -e {} \\; -print -delete",
    "start": "electron .",
    "dev": "DIRA_MULTI_TOKEN=${DIRA_MULTI_TOKEN:-1} pnpm build && pnpm start",
    "test": "node --test \"*.test.ts\"",
    "icns": "./make-icns.sh",
    "signcheck": "./sign-preflight.sh",
    "release": "./release.sh",
    "dist": "./sign-preflight.sh && pnpm build && electron-builder --publish never && { test -e dist/mac-arm64/dira.app/Contents/Resources/server/node_modules/next || { echo '번들에 server/node_modules가 없다 — extraResources의 node_modules 항목을 확인하라' >&2; exit 1; }; } && { test -e dist/mac-arm64/dira.app/Contents/Resources/engine/dispatch.py || { echo '번들에 engine/dispatch.py가 없다 - extraResources의 dispatch.py 항목을 확인하라' >&2; exit 1; }; } && ./sign-dmg.sh && du -sh dist/mac-arm64/dira.app dist/*.dmg",
    "dist:internal": "DIRA_MULTI_TOKEN=1 pnpm run dist"
  },
  "build": {
    "appId": "dev.dira.desktop",
    "productName": "dira",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.ts",
      "!*.test.ts",
      "preload.cjs",
      "package.json",
      "ga.json",
      "trayTemplate.png",
      "trayTemplate@2x.png",
      "node_modules/**/*"
    ],
    "asar": false,
    "publish": {
      "provider": "github",
      "owner": "proofer-tech",
      "repo": "dira"
    },
    "extraResources": [
      {
        "from": "../teams/.next/standalone",
        "to": "server"
      },
      {
        "from": "../teams/.next/standalone/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "mcp-keepalive.sh",
        "to": "mcp-keepalive.sh"
      },
      {
        "from": "../../tick.sh",
        "to": "engine/tick.sh"
      },
      {
        "from": "../../tickets.py",
        "to": "engine/tickets.py"
      },
      {
        "from": "../../dispatch.py",
        "to": "engine/dispatch.py"
      },
      {
        "from": "../../dira_env.py",
        "to": "engine/dira_env.py"
      },
      {
        "from": "../../mcp_server.py",
        "to": "engine/mcp_server.py"
      },
      {
        "from": "../../mcp_tools.py",
        "to": "engine/mcp_tools.py"
      },
      {
        "from": "../../graph.py",
        "to": "engine/graph.py"
      },
      {
        "from": "../../learn.py",
        "to": "engine/learn.py"
      },
      {
        "from": "../../remote.py",
        "to": "engine/remote.py"
      },
      {
        "from": "../../ontology_read.py",
        "to": "engine/ontology_read.py"
      },
      {
        "from": "../../agy-gui.sh",
        "to": "engine/agy-gui.sh"
      },
      {
        "from": "../../templates",
        "to": "engine/templates"
      },
      {
        "from": "../../worker.sh.example",
        "to": "engine/worker.sh.example"
      },
      {
        "from": "../../protocols",
        "to": "engine/protocols"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "filesystem": "APFS"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^41.10.3",
    "electron-builder": "^26.0.0"
  }
}
